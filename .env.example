# =============================================================
# BHAIRAV AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — only commit this .env.example file.
# =============================================================

# ── API KEYS ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── INDEX FILE PATHS ─────────────────────────────────────────
# Point these to your /indexes folder after building the index
FAISS_INDEX_PATH=indexes/bhairav_faiss.index
BM25_INDEX_PATH=indexes/bhairav_bm25.pkl
METADATA_PATH=indexes/bhairav_metadata.json
ID_MAP_PATH=indexes/bhairav_id_map.json
MW_INDEX_PATH=indexes/mw_index.json

# ── MODEL SETTINGS ────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.3

# ── RETRIEVAL SETTINGS ───────────────────────────────────────
FAISS_TOP_K=40
RERANK_TOP_N=15
NEIGHBOR_WINDOW=2
FAST_RETRIEVAL=true

# ── ENTITY RESOLUTION ────────────────────────────────────────
WIKIDATA_ENABLED=false
ENTITY_FUZZY_THRESHOLD=80
SYNONYM_FUZZY_ENABLED=false
REQUIRE_HARVESTED_MAPS=false
OFFLINE_ENTITY_CONFIDENCE_THRESHOLD=0.80

# ── OPTIONAL SERVICES ────────────────────────────────────────
# Set to true only if you have these configured
GEMINI_ENABLED=false
INDICXLIT_ENABLED=false
